#!name=中国广电自动读取
#!desc=捕获当前设备中国广电官方请求，并为 ChinaBroadnetMonitor 自动注入访问数据
#!system=ios

[Script]
中国广电自动读取 = type=http-request, pattern=^https:\/\/wx\.10099\.com\.cn\/contact-web\/api\/busi\/qryUserInfo(?:\?.*)?$, script-path=https://raw.githubusercontent.com/ayoaak/ScriptingScripts/test/ChinaBroadnetMonitor/rewrite/broadnet-capture.js, requires-body=true, timeout=10

[MITM]
hostname = %APPEND% wx.10099.com.cn
